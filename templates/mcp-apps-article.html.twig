<section class="mcp-article-page">
  <div class="olivero-preview">
    <div class="olivero-brand">Drupal <span>Stories &amp; ideas</span></div>
    <article>
      <p class="article-kicker">ARTICLE</p>
      <h1 class="mcp-article-title">{{ article.title }}</h1>
      <p class="article-byline">By {{ article.byline }} · {{ article.date }}</p>
      <div class="article-image">{{ hero }}</div>
      <p class="article-summary">{{ article.summary }}</p>
    </article>
  </div>
</section>
