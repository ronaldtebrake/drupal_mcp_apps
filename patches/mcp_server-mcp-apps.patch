@@ -5,6 +5,7 @@ declare(strict_types=1);
 namespace Drupal\Tests\mcp_server\Unit\Definition;
 
 use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\mcp_server\Attribute\Tool;
 use Drupal\mcp_server\Definition\ToolDefinition;
 use Drupal\mcp_server\Plugin\Discovery\WireSafeDerivativeDiscoveryDecorator;
 use Drupal\Tests\UnitTestCase;
@@ -100,4 +101,27 @@ final class ToolDefinitionTest extends UnitTestCase {
     return $base;
   }
 
+  /**
+   * Metadata survives attributes and can be inherited, replaced, or cleared.
+   */
+  public function testMetadataInheritanceAndOverride(): void {
+    $meta = ['ui' => ['resourceUri' => 'ui://test/app'], 'test/custom' => 7];
+    $label = new TranslatableMarkup('Test app');
+    $attribute = new Tool('app', $label, $label, meta: $meta);
+    $attribute->setClass(self::class);
+    $attribute->setProvider('mcp_server_test');
+    $base = $attribute->get();
+
+    $this->assertSame($meta, $base->meta);
+    $this->assertSame($meta, $base->withDerivative('inherited', $label)->meta);
+    $this->assertSame($meta, $base->withDerivative('null', $label, meta: NULL)->meta);
+    $this->assertSame([], $base->withDerivative('cleared', $label, meta: [])->meta);
+    $override = ['ui' => ['resourceUri' => 'ui://test/other']];
+    $this->assertSame($override, $base->withDerivative('replaced', $label, meta: $override)->meta);
+    $this->assertSame($meta, $base->meta);
+    $plain = new Tool('plain', $label, $label);
+    $plain->setClass(self::class);
+    $this->assertSame([], $plain->get()->meta);
+  }
+
 }
