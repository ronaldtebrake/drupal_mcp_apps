diff --git a/tests/src/Unit/Capability/Handler/ResourceProviderHandlerTest.php b/tests/src/Unit/Capability/Handler/ResourceProviderHandlerTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..e9816ce3da3a705f4e6f0f93d2d7eb2eecd00450
--- /dev/null
+++ b/tests/src/Unit/Capability/Handler/ResourceProviderHandlerTest.php
@@ -0,0 +1,94 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\mcp_server\Unit\Capability\Handler;
+
+use Drupal\Component\Datetime\TimeInterface;
+use Drupal\Core\Access\AccessResult;
+use Drupal\Core\Cache\Context\CacheContextsManager;
+use Drupal\Core\Cache\Context\ContextCacheKeys;
+use Drupal\Core\Cache\MemoryBackend;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\mcp_server\Capability\Handler\ResourceProviderHandler;
+use Drupal\mcp_server\Capability\Handler\ResourceTemplateProviderHandler;
+use Drupal\mcp_server\Plugin\ResourceProviderInterface;
+use Drupal\mcp_server\Plugin\ResourceTemplateProviderInterface;
+use Drupal\mcp_server\Resource\CacheableResourceContent;
+use Drupal\mcp_server\Resource\ResourceContentCache;
+use Drupal\Tests\UnitTestCase;
+use Mcp\Schema\Content\BlobResourceContents;
+use Mcp\Schema\Content\TextResourceContents;
+use Mcp\Server\ClientGateway;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests resource handlers preserve content metadata on fresh and cached reads.
+ *
+ * @group mcp_server
+ */
+#[Group('mcp_server')]
+final class ResourceProviderHandlerTest extends UnitTestCase {
+
+  /**
+   * Both handlers convert text and blobs without losing content metadata.
+   *
+   * @param bool $template
+   *   Whether to use the resource template handler.
+   * @param bool $blob
+   *   Whether to supply blob content.
+   */
+  #[DataProvider('contentProvider')]
+  public function testContentMetadata(bool $template, bool $blob): void {
+    $uri = 'ui://test/app';
+    $content = [
+      'uri' => $uri,
+      'mimeType' => $blob ? 'application/octet-stream' : 'text/html;profile=mcp-app',
+      $blob ? 'blob' : 'text' => $blob ? base64_encode('test') : '<h1>Test app</h1>',
+      '_meta' => ['ui' => ['csp' => ['resourceDomains' => ['https://example.com']]]],
+    ];
+    $contexts = $this->createMock(CacheContextsManager::class);
+    $contexts->method('convertTokensToKeys')->willReturn(new ContextCacheKeys([]));
+    $cache = new ResourceContentCache(
+      new MemoryBackend($this->createMock(TimeInterface::class)),
+      $contexts,
+    );
+    $account = $this->createMock(AccountInterface::class);
+    $gateway = $this->createMock(ClientGateway::class);
+    if ($template) {
+      $plugin = $this->createMock(ResourceTemplateProviderInterface::class);
+      $handler = new ResourceTemplateProviderHandler($plugin, $cache, $account);
+      $read = fn() => $handler->read($uri, [], $gateway);
+    }
+    else {
+      $plugin = $this->createMock(ResourceProviderInterface::class);
+      $handler = new ResourceProviderHandler($plugin, $cache, $account);
+      $read = fn() => $handler->read($uri, $gateway);
+    }
+    $plugin->expects($this->exactly(2))->method('checkAccess')
+      ->with($uri, $account)->willReturn(AccessResult::allowed());
+    $plugin->expects($this->once())->method('getResourceContent')
+      ->with($uri)->willReturn(CacheableResourceContent::fromArray($content));
+
+    // The second read exercises conversion of the stored content array.
+    for ($i = 0; $i < 2; $i++) {
+      $result = $read();
+      $this->assertInstanceOf($blob ? BlobResourceContents::class : TextResourceContents::class, $result);
+      $this->assertEquals($content, $result->jsonSerialize());
+    }
+  }
+
+  /**
+   * Covers both content types in both resource handlers.
+   */
+  public static function contentProvider(): array {
+    return [
+      'resource text' => [FALSE, FALSE],
+      'resource blob' => [FALSE, TRUE],
+      'template text' => [TRUE, FALSE],
+      'template blob' => [TRUE, TRUE],
+    ];
+  }
+
+}
