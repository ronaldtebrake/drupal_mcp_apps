+  /**
+   * App links and unrelated metadata survive derivative cloning.
+   */
+  public function testMetadataInheritanceAndOverride(): void {
+    $meta = ['ui' => ['resourceUri' => 'ui://test/app'], 'test/custom' => 7];
+    $label = new TranslatableMarkup('Test app');
+    $base = new ToolDefinition('app', $label, $label, meta: $meta);
+    $base->setClass(self::class);
+    $this->assertSame($meta, $base->withDerivative('one', $label)->meta);
+    $this->assertSame([], $base->withDerivative('two', $label, meta: [])->meta);
+    $this->assertSame($meta, $base->meta);
+  }
+
