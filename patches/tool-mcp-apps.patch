--- a/tests/src/Unit/ExecutableResultTest.php
+++ b/tests/src/Unit/ExecutableResultTest.php
@@ -8,6 +8,7 @@ use Drupal\Core\StringTranslation\TranslatableMarkup;
 use Drupal\Tests\UnitTestCase;
 use Drupal\tool\ExecutableResult;
 use Drupal\tool\FailureCategory;
+use Drupal\tool\FormattedExecutableResult;
 
 /**
  * Tests the ExecutableResult value object.
@@ -86,4 +87,37 @@ class ExecutableResultTest extends UnitTestCase {
     $this->assertSame(FailureCategory::Runtime, $result->getFailureCategory());
   }
 
+  /**
+   * Tests metadata stays separate from outputs during result formatting.
+   */
+  public function testMetadata(): void {
+    $message = new TranslatableMarkup('Done.');
+    $values = ['result' => 'original'];
+    $transformed = ['result' => 'formatted'];
+    $meta = ['test/presentation' => ['image' => 'preview']];
+    $results = [
+      new ExecutableResult(TRUE, $message, $values, meta: $meta),
+      ExecutableResult::success($message, $values, meta: $meta),
+      ExecutableResult::failure($message, $values, FailureCategory::Runtime, meta: $meta),
+    ];
+    foreach ($results as $result) {
+      $formatted = new FormattedExecutableResult($result, $transformed);
+      $this->assertSame($meta, $result->getMeta());
+      $this->assertSame($values, $result->getContextValues());
+      $this->assertSame($meta, $formatted->getMeta());
+      $this->assertSame($transformed, $formatted->getContextValues());
+      $this->assertSame($result->isSuccess(), $formatted->isSuccess());
+      $this->assertSame($result->getFailureCategory(), $formatted->getFailureCategory());
+    }
+    $defaults = [
+      new ExecutableResult(TRUE, $message),
+      ExecutableResult::success($message),
+      ExecutableResult::failure($message),
+    ];
+    foreach ($defaults as $result) {
+      $this->assertSame([], $result->getMeta());
+      $this->assertSame([], (new FormattedExecutableResult($result))->getMeta());
+    }
+  }
+
 }
