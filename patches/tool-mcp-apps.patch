diff --git a/tests/src/Kernel/Tool/ToolDefinitionTest.php b/tests/src/Kernel/Tool/ToolDefinitionTest.php
index a7c2692211f78e493519f9054488731596983062..8bbe3c1df0991119ece15fba1b533ba666a041c7 100644
--- a/tests/src/Kernel/Tool/ToolDefinitionTest.php
+++ b/tests/src/Kernel/Tool/ToolDefinitionTest.php
@@ -51,4 +51,26 @@ class ToolDefinitionTest extends KernelTestBase {
     $this->assertNull($definition->get('does_not_exist'));
   }
 
+  /**
+   * Tests attribute metadata is retained separately from typed definitions.
+   */
+  public function testMetadata(): void {
+    $definition = $this->container->get('plugin.manager.tool')->getDefinition('greeting_tool');
+    $this->assertInstanceOf(ToolDefinition::class, $definition);
+    $meta = ['ui' => ['resourceUri' => 'ui://test/greeting'], 'test/custom' => 7];
+    $this->assertSame($meta, $definition->getMeta());
+    $this->assertSame(['name', 'greeting'], array_keys($definition->getInputDefinitions()));
+    $this->assertSame(['message'], array_keys($definition->getOutputDefinitions()));
+    $this->assertSame([], (new ToolDefinition(['id' => 'plain']))->getMeta());
+
+    $derivative = clone $definition;
+    $this->assertSame($meta, $derivative->getMeta());
+    $replacement = ['test/custom' => 'replacement'];
+    $this->assertSame($derivative, $derivative->setMeta($replacement));
+    $this->assertSame($replacement, $derivative->getMeta());
+    $derivative->setMeta([]);
+    $this->assertSame([], $derivative->getMeta());
+    $this->assertSame($meta, $definition->getMeta());
+  }
+
 }
