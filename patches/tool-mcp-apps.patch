+  /**
+   * Metadata stays separate from outputs through result formatting.
+   */
+  public function testPresentationMetadata(): void {
+    $meta = ['ui/custom' => ['image' => 'presentation-only']];
+    $values = ['result' => 'model-visible'];
+    $message = new TranslatableMarkup('Done.');
+    $result = ExecutableResult::success($message, $values, $meta);
+    $formatted = new FormattedExecutableResult($result, $values);
+    $this->assertSame($meta, $result->getMeta());
+    $this->assertSame($meta, $formatted->getMeta());
+    $this->assertSame($values, $formatted->getContextValues());
+    $this->assertSame([], ExecutableResult::success($message)->getMeta());
+    $this->assertSame($meta, ExecutableResult::failure($message, meta: $meta)->getMeta());
+  }
+
