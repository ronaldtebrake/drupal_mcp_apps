<?php

/**
 * @file
 * Supplies permission checks for access tests.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * {@inheritdoc}
 */
function mcp_apps_test_entity_field_access(string $operation, FieldDefinitionInterface $field, AccountInterface $account): AccessResult {
  return AccessResult::forbiddenIf($operation === 'view' && $field->getType() === 'image' && $account->hasPermission('deny test image field'))->cachePerPermissions();
}
