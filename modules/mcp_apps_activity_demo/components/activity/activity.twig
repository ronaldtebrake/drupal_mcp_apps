<section class="pulse-panel pulse-activity"><header class="pulse-panel-heading"><div><h2>Behind the stories</h2><p>Your team’s recent activity.</p></div><span class="pulse-live-dot" aria-hidden="true"></span></header><ol>{% for event in events %}<li><span class="pulse-avatar">{{ event.actor|slice(0,1) }}</span><div><small class="pulse-time">{{ event.time }}</small><p><strong>{{ event.actor }}</strong> <span class="pulse-action">{{ event.action|lower }}</span></p><strong class="pulse-event-title">{{ event.title }}</strong><p class="pulse-event-detail">{{ event.detail }}</p></div></li>{% endfor %}</ol>{% if not events %}<p>No sample activity in this selection.</p>{% endif %}</section>
