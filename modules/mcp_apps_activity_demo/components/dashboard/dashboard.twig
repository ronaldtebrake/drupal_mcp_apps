<section class="pulse-dashboard" aria-label="{{ title }}">
  <header class="pulse-heading">
    <div><div class="pulse-eyebrow"><span class="pulse-mark">●</span> ROTTERDAM JOURNAL <span class="pulse-demo">Demo data</span></div><h1>{{ title }}</h1><p>{{ description }}</p></div>
    <div class="pulse-period">{{ period }}<small>Sample snapshot · {{ as_of }}</small></div>
  </header>
  <div class="pulse-metrics">{{ metrics }}</div>
  <div class="pulse-layout"><div class="pulse-main">{{ chart }}{{ content }}</div><aside class="pulse-sidebar">{{ activity }}<div class="pulse-reuse"><span>BUILT ONCE. USED TWICE.</span><strong>From your website<br>to your conversation.</strong><p>The same Drupal components and Tool API report power this page and the MCP App.</p></div></aside></div>
  <footer class="pulse-footnote">Fictional stories, people and analytics for this demonstration. No real readership is collected.</footer>
</section>
