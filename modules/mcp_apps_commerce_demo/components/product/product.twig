<article class="shop-product" data-shop-product="{{ product.id }}">
  <div class="shop-product-art"><span class="shop-category">{{ product.category|capitalize }}</span><img src="{{ product.image }}" alt="{{ product.title }}" width="560" height="440">{% if can_compare is not defined or can_compare %}<label class="shop-compare-toggle"><input type="checkbox" data-shop-compare="{{ product.id }}" {{ compared ? 'checked' }}> Compare</label>{% endif %}</div>
  <div class="shop-product-body"><div class="shop-product-title"><h2>{{ product.title }}</h2><strong data-shop-price>{{ product.variants[0].price }}</strong></div><p>{{ product.description }}</p><details class="shop-specs" {{ show_details ? 'open' }}><summary>{{ show_details ? 'Specifications' : 'The details' }}</summary><dl>{% for spec in product.specs %}<div><dt>{{ spec.label }}</dt><dd>{{ spec.value }}</dd></div>{% endfor %}</dl></details>
  <form data-shop-form="cart" data-shop-product="{{ product.id }}"><label class="shop-option-label">Finish<select name="variation_id" aria-label="Finish for {{ product.title }}">{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" {{ not variant.available ? 'disabled' }}>{{ variant.label }} · {{ variant.price }}{{ not variant.available ? ' · unavailable' }}</option>{% endfor %}</select></label><input type="number" name="quantity" min="1" max="10" value="1" aria-label="Quantity for {{ product.title }}"><button class="shop-button" type="button" data-shop-submit {{ product.variants|filter(v => v.available)|length == 0 ? 'disabled' }}>Add to basket <span>+</span></button></form></div>
</article>
