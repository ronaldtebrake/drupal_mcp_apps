<section class="shop-comparison" aria-label="Product comparison"><header><div><span class="shop-eyebrow">FIND YOUR FIT</span><h2>The details, side by side.</h2></div><button type="button" data-shop-clear-compare class="shop-text-button">Clear comparison ×</button></header><div class="shop-comparison-grid">{% for product in products %}<article><h3>{{ product.title }}</h3><strong>{{ product.variants[0].price }}</strong><dl>{% for spec in product.specs %}<div><dt>{{ spec.label }}</dt><dd>{{ spec.value }}</dd></div>{% endfor %}</dl></article>{% endfor %}</div></section>
