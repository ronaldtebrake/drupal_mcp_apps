<section class="shop-basket-card" aria-label="Your basket"><header><h2>Your basket</h2><span>{{ cart.count }}</span></header>
{% if cart.items|length %}{% for item in cart.items %}<div class="shop-basket-item"><strong>{{ item.title }}</strong><form data-shop-form="quantity"><input type="hidden" name="variation_id" value="{{ item.variation_id }}"><label>Quantity<input name="quantity" type="number" min="0" max="10" value="{{ item.quantity }}" aria-label="Basket quantity for {{ item.title }}"></label><button type="button" data-shop-submit class="shop-text-button">Update</button><span>{{ item.total }}</span></form><button type="button" class="shop-text-button" data-shop-remove="{{ item.variation_id }}">Remove</button></div>{% endfor %}
<div class="shop-basket-total"><span>Total</span><strong>{{ cart.total }}</strong></div><p class="shop-basket-note">Demo checkout. No shipping, real payment or fulfilment.</p>
{% if can_checkout %}<button type="button" class="shop-button shop-checkout" data-shop-review>Review test order <span>↗</span></button><dialog class="shop-review" aria-label="Review test order"><button type="button" class="shop-review-close" data-shop-close-review aria-label="Close review">×</button><span class="shop-eyebrow">ONE LAST LOOK</span><h2>Ready for your next ritual?</h2><p>You're placing a test order in Drupal Commerce. No money will be charged.</p><ul>{% for item in cart.items %}<li><span>{{ item.quantity }} × {{ item.title }}</span><strong>{{ item.total }}</strong></li>{% endfor %}</ul><div class="shop-basket-total"><span>Test order total</span><strong>{{ cart.total }}</strong></div><button type="button" class="shop-button" data-shop-checkout data-order="{{ cart.id }}" data-revision="{{ cart.revision }}">Place test order · {{ cart.total }}</button></dialog>{% else %}<p>You can browse and build a basket. Test checkout requires additional permission.</p>{% endif %}
{% else %}<div class="shop-empty-basket"><span>＋</span><h3>A little room for something good.</h3><p>Choose a finish and add your favourite coffee gear.</p></div>{% endif %}
</section>
