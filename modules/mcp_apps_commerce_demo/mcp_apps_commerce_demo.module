<?php

/**
 * @file
 * Presentation hooks for the Commerce showcase.
 */

/**
 * Implements hook_theme().
 */
function mcp_apps_commerce_demo_theme(): array {
  return [
    'page__mcp_apps_shop' => [
      'base hook' => 'page',
      'template' => 'page--mcp-apps-shop',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function mcp_apps_commerce_demo_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() === 'mcp_apps_commerce_demo.shop') {
    $suggestions[] = 'page__mcp_apps_shop';
  }
}

/**
 * Implements hook_preprocess_page().
 */
function mcp_apps_commerce_demo_preprocess_page(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'mcp_apps_commerce_demo.shop') {
    return;
  }
  $content = $variables['page']['content'] ?? [];
  foreach (\Drupal\Core\Render\Element::children($content) as $key) {
    if (($content[$key]['#type'] ?? '') === 'page_title' || (isset($content[$key]['#base_plugin_id']) && !in_array($content[$key]['#base_plugin_id'], ['system_main_block', 'system_messages_block'], TRUE))) {
      unset($content[$key]);
    }
  }
  $variables['storefront_content'] = $content;
}
