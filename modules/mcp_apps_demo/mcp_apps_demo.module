<?php

/**
 * @file
 * Supplies an optional, read-only composition using existing components.
 */

use Drupal\mcp_apps_demo\DemoComposition;

/**
 * {@inheritdoc}
 */
function mcp_apps_demo_mcp_apps_composer_defaults_alter(array &$data): void {
  if ($data['program'] === '' && $data['theme'] === 'mcp_apps_demo_theme') {
    if ($data['title'] === 'Component preview') {
      $data['title'] = 'A weekend in Rotterdam';
    }
    $data['tree'] = DemoComposition::tree($data['title']);
  }
  $data['media_tool'] = 'tool_api__composer_media_search';
  $data['media_query'] = 'Rotterdam';
  $data['initial_component'] = 'mcp_apps_demo_theme:hero-side-by-side';
}
