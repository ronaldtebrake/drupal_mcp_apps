<?php

/**
 * @file
 * Upgrade the earlier showcase without deleting its content or files.
 */

/**
 * Remove the retired hero tools and resource registration.
 */
function mcp_apps_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('mcp_server.resource_providers');
  $plugins = $config->get('plugins') ?? [];
  unset($plugins['mcp_apps_media_picker']);
  $config->set('plugins', $plugins)->save();
  foreach (['media_picker_open', 'media_picker_save_hero'] as $id) {
    $config = \Drupal::configFactory()->getEditable('mcp_server_tool_bridge.mcp_tool_config.' . $id);
    if ($config->get('tool_id') === $id) {
      $config->delete();
    }
  }
}
